#!/usr/bin/env php
<?php
/*
 * nntmux-setup — setup helper for the NNTmux app. Runs inside `nntmux-scanner`:
 *
 *   docker exec nntmux-scanner nntmux-setup status          what is configured, what is missing
 *   docker exec nntmux-scanner nntmux-setup groups [text]   find usenet group names
 *   docker exec nntmux-scanner nntmux-setup api-user NAME   create/reuse an API user, print its key
 *   docker exec nntmux-scanner nntmux-setup apply           apply the app settings now
 *   docker exec nntmux-scanner nntmux-setup prune           delete releases under the minimum size (scan loop runs it)
 *   docker exec nntmux-scanner nntmux-setup fixnames [max]  rename uncategorised releases (scan loop runs it)
 *
 * The app's settings are the NNTP_* / NNTMUX_* keys of the app's `.env` (Maison:
 * App settings > Env). They reach this container prefixed (SETUP_*), never under
 * their own names: nntmux's dotenv is immutable, so an EMPTY NNTP_SERVER in a
 * process environment would override `nntmux.env` and blank the provider.
 *
 * `apply` runs before every scan pass, so the settings hold across the image's
 * re-seed of `settings` / `usenet_groups` on each boot. A blank key is left
 * alone: whatever was set in the admin UI stands.
 */

const ENV_FILE = '/app/.env';
const PROVIDER_KEYS = ['NNTP_SERVER', 'NNTP_PORT', 'NNTP_USERNAME', 'NNTP_PASSWORD', 'NNTP_CONNECTIONS', 'NNTP_SSLENABLED'];
const API_ROLE = 'API client';
const API_CAPS = ['apirequests' => 1000000, 'downloadrequests' => 1000000, 'rate_limit' => 600];

function want(string $k): string
{
    $v = getenv('SETUP_'.$k);

    return $v === false ? '' : trim($v);
}

function out(string $s): void
{
    fwrite(STDOUT, $s.PHP_EOL);
}

function fail(string $s): never
{
    fwrite(STDERR, 'nntmux-setup: '.$s.PHP_EOL);
    exit(1);
}

function on_off(string $v, string $key): ?int
{
    if ($v === '') {
        return null;
    }
    $v = strtolower($v);
    if (in_array($v, ['on', '1', 'true', 'yes'], true)) {
        return 1;
    }
    if (in_array($v, ['off', '0', 'false', 'no'], true)) {
        return 0;
    }
    out("! $key=$v is not on/off — ignored");

    return null;
}

/** dotenv-safe value: bare when simple, double-quoted otherwise. */
function env_value(string $v): string
{
    return preg_match('#^[A-Za-z0-9_.:@/+-]*$#', $v) ? $v : '"'.addcslashes($v, "\"\\").'"';
}

/** KEY=value pairs of the nntmux .env (unquoted). */
function read_env(): array
{
    $vals = [];
    foreach (@file(ENV_FILE, FILE_IGNORE_NEW_LINES) ?: [] as $l) {
        if (preg_match('/^([A-Z0-9_]+)=(.*)$/', $l, $m)) {
            $v = trim($m[2]);
            if (strlen($v) >= 2 && $v[0] === '"' && substr($v, -1) === '"') {
                $v = stripcslashes(substr($v, 1, -1));
            }
            $vals[$m[1]] = $v;
        }
    }

    return $vals;
}

/** Write non-blank SETUP_NNTP_* into nntmux's .env, in place (it is a bind-mounted file). */
function sync_provider(): array
{
    $lines = @file(ENV_FILE, FILE_IGNORE_NEW_LINES);
    if ($lines === false) {
        fail('cannot read '.ENV_FILE);
    }
    $changed = [];
    foreach (PROVIDER_KEYS as $k) {
        $v = want($k);
        if ($v === '') {
            continue;
        }
        $line = $k.'='.env_value($v);
        $found = false;
        foreach ($lines as $i => $l) {
            if (str_starts_with($l, $k.'=')) {
                $found = true;
                if ($l !== $line) {
                    $lines[$i] = $line;
                    $changed[] = $k;
                }
            }
        }
        if (! $found) {
            $lines[] = $line;
            $changed[] = $k;
        }
    }
    if ($changed) {
        file_put_contents(ENV_FILE, implode("\n", $lines)."\n");
    }

    return $changed;
}

function boot(): void
{
    chdir('/app');
    require '/app/vendor/autoload.php';
    $app = require '/app/bootstrap/app.php';
    $app->make(Illuminate\Contracts\Console\Kernel::class)->bootstrap();
}

function setting(string $name): ?string
{
    return Illuminate\Support\Facades\DB::table('settings')->where('name', $name)->value('value');
}

/** Set a setting; returns true when it changed. */
function set_setting(string $name, string $value): bool
{
    if (setting($name) === $value) {
        return false;
    }
    Illuminate\Support\Facades\DB::table('settings')->where('name', $name)->update(['value' => $value]);

    return true;
}

function cmd_apply(): void
{
    $log = [];
    foreach (sync_provider() as $k) {
        $log[] = "provider: $k updated in nntmux.env";
    }
    boot();
    $DB = Illuminate\Support\Facades\DB::class;

    $reg = strtolower(want('NNTMUX_REGISTRATION'));
    if ($reg !== '') {
        $map = ['open' => '0', 'invite' => '1', 'closed' => '2'];
        if (! isset($map[$reg])) {
            $log[] = "! NNTMUX_REGISTRATION=$reg is not open/invite/closed — ignored";
        } elseif (set_setting('registerstatus', $map[$reg])) {
            $log[] = "registration: $reg";
        }
    }

    $scan = on_off(want('NNTMUX_SCAN'), 'NNTMUX_SCAN');
    if ($scan !== null) {
        if (set_setting('running', (string) $scan)) {
            $log[] = 'scan: '.($scan ? 'on' : 'off');
        }
        if ($scan === 1 && set_setting('binaries', '1')) {
            $log[] = 'header scan (binaries): on';
        }
    }
    $backfill = on_off(want('NNTMUX_BACKFILL'), 'NNTMUX_BACKFILL');
    if ($backfill !== null && set_setting('backfill', (string) $backfill)) {
        $log[] = 'backfill: '.($backfill ? 'on' : 'off');
    }
    foreach (['NNTMUX_BACKFILL_DAYS' => 'backfill_days', 'NNTMUX_BACKFILL_QTY' => 'backfill_qty', 'NNTMUX_MONITOR_DELAY' => 'monitor_delay', 'NNTMUX_MIN_RELEASE_MB' => 'minsizetoformrelease'] as $k => $s) {
        $v = want($k);
        if ($v === '') {
            continue;
        }
        if (! ctype_digit($v)) {
            $log[] = "! $k=$v is not a whole number — ignored";
            continue;
        }
        // nntmux stores the release floor in bytes. It drops smaller collections
        // before they become releases, and deletes existing smaller releases
        // on the next collation.
        $stored = $s === 'minsizetoformrelease' ? (string) ((int) $v * 1048576) : $v;
        if (set_setting($s, $stored)) {
            $log[] = $s === 'minsizetoformrelease' ? "minimum release size: $v MB" : "$s: $v";
        }
    }

    $groups = array_values(array_filter(array_map('trim', explode(',', want('NNTMUX_GROUPS')))));
    if ($groups) {
        $known = $DB::table('usenet_groups')->whereIn('name', $groups)->pluck('name')->all();
        foreach (array_diff($groups, $known) as $g) {
            $log[] = "! group $g is unknown to nntmux (see: nntmux-setup groups ".explode('.', $g)[count(explode('.', $g)) - 1].')';
        }
        $set = ['active' => 1];
        if ($backfill !== null) {
            $set['backfill'] = $backfill;
        }
        $q = $DB::table('usenet_groups')->whereIn('name', $known)->where(function ($w) use ($set) {
            foreach ($set as $c => $v) {
                $w->orWhere($c, '!=', $v);
            }
        });
        $n = (clone $q)->count();
        if ($n > 0) {
            $q->update($set);
            $log[] = "groups: $n activated (".implode(', ', $known).')';
        }
    }

    foreach ($log as $l) {
        out($l);
    }
}

function cmd_status(): void
{
    $env = read_env();
    $have = fn ($k) => isset($env[$k]) && $env[$k] !== '';
    out('Provider (nntmux.env)');
    out('  server      : '.($have('NNTP_SERVER') ? $env['NNTP_SERVER'].':'.($env['NNTP_PORT'] ?? '?').(($env['NNTP_SSLENABLED'] ?? 'true') === 'true' ? ' (TLS)' : '') : 'NOT SET'));
    out('  username    : '.($have('NNTP_USERNAME') ? 'set' : 'NOT SET'));
    out('  password    : '.($have('NNTP_PASSWORD') ? 'set' : 'NOT SET'));
    out('  connections : '.($env['NNTP_CONNECTIONS'] ?? '?'));

    boot();
    $DB = Illuminate\Support\Facades\DB::class;
    $provider_ok = $have('NNTP_SERVER') && $have('NNTP_USERNAME') && $have('NNTP_PASSWORD');
    if ($provider_ok) {
        $msg = 'ok';
        try {
            $nntp = new Blacklight\NNTP;
            $r = $nntp->doConnect(false);
            if ($r !== true) {
                $msg = 'FAILED: '.(is_object($r) && method_exists($r, 'getMessage') ? $r->getMessage() : var_export($r, true));
                $provider_ok = false;
            }
            $nntp->doQuit();
        } catch (Throwable $e) {
            $msg = 'FAILED: '.$e->getMessage();
            $provider_ok = false;
        }
        out('  connect     : '.$msg);
    }

    $active = $DB::table('usenet_groups')->where('active', 1)->pluck('name')->all();
    $reg = ['0' => 'open', '1' => 'invite only', '2' => 'closed'][setting('registerstatus') ?? ''] ?? '?';
    out('Scanning');
    out('  active groups : '.($active ? implode(', ', $active) : 'none'));
    out('  scan (running): '.(setting('running') === '1' ? 'on' : 'off').'   header scan: '.(setting('binaries') === '1' ? 'on' : 'off').'   backfill: '.(setting('backfill') === '1' ? 'on (days '.setting('backfill_days').')' : 'off'));
    out('  pass delay    : '.setting('monitor_delay').'s');
    out('  releases      : '.$DB::table('releases')->count().'   (smaller than '.round((int) setting('minsizetoformrelease') / 1048576).' MB dropped)');
    out('  registration  : '.$reg);

    out('Managed by the app settings (Env) — blank = not managed');
    foreach (['NNTP_SERVER', 'NNTP_USERNAME', 'NNTP_PASSWORD', 'NNTMUX_GROUPS', 'NNTMUX_SCAN', 'NNTMUX_BACKFILL', 'NNTMUX_BACKFILL_DAYS', 'NNTMUX_BACKFILL_QTY', 'NNTMUX_MONITOR_DELAY', 'NNTMUX_REGISTRATION', 'NNTMUX_MIN_RELEASE_MB'] as $k) {
        $v = want($k);
        out(sprintf('  %-21s: %s', $k, $v === '' ? '-' : (str_contains($k, 'PASSWORD') ? 'set' : $v)));
    }

    out('Next step');
    if (! $provider_ok) {
        out('  Set your Usenet provider: NNTP_SERVER, NNTP_PORT, NNTP_USERNAME, NNTP_PASSWORD in the app settings (Env), then Save.');
    } elseif (! $active) {
        out('  Choose groups to index: NNTMUX_GROUPS=alt.binaries.example,... in the app settings (Env). Find names with: nntmux-setup groups <text>');
    } elseif (setting('running') !== '1') {
        out('  Start scanning: NNTMUX_SCAN=on in the app settings (Env). Watch it with: docker logs -f nntmux-scanner');
    } else {
        out('  Scanning. Watch it with: docker logs -f nntmux-scanner');
    }
}

function cmd_groups(string $text): void
{
    boot();
    $q = Illuminate\Support\Facades\DB::table('usenet_groups')->orderBy('name');
    if ($text !== '') {
        $q->where('name', 'like', '%'.$text.'%');
    }
    $rows = $q->limit(60)->get(['name', 'active', 'backfill']);
    foreach ($rows as $g) {
        out(sprintf('  %-50s %s', $g->name, $g->active ? 'ACTIVE'.($g->backfill ? ' +backfill' : '') : ''));
    }
    out(count($rows) === 60 ? '  (first 60 — narrow the search)' : '  ('.count($rows).' groups)');
}

function cmd_api_user(string $name): void
{
    if (! preg_match('/^[A-Za-z0-9_.-]{3,40}$/', $name)) {
        fail('user name: 3-40 letters, digits, . _ -');
    }
    boot();
    $DB = Illuminate\Support\Facades\DB::class;
    $r = $DB::table('roles')->where('name', API_ROLE)->first();
    if (! $r) {
        $id = $DB::table('roles')->insertGetId(API_CAPS + ['name' => API_ROLE, 'guard_name' => 'web', 'defaultinvites' => 0, 'isdefault' => 0, 'donation' => 0, 'addyears' => 0, 'created_at' => now(), 'updated_at' => now()]);
    } else {
        $id = $r->id;
        $DB::table('roles')->where('id', $id)->update(API_CAPS);
    }
    app()[Spatie\Permission\PermissionRegistrar::class]->forgetCachedPermissions();
    Spatie\Permission\Models\Role::findById($id, 'web')->syncPermissions(Spatie\Permission\Models\Role::findByName('User', 'web')->permissions);

    $u = App\Models\User::where('username', $name)->first();
    if ($u && $u->roles_id == 2) {
        fail("$name is an admin account — pick another name for an API client");
    }
    if (! $u) {
        App\Models\User::add($name, Illuminate\Support\Str::random(40), $name.'@nntmux.invalid', $id);
        $u = App\Models\User::where('username', $name)->first();
    }
    $u->update(['roles_id' => $id, 'rate_limit' => API_CAPS['rate_limit'], 'verified' => 1, 'email_verified_at' => $u->email_verified_at ?? now()]);
    $u->syncRoles([API_ROLE]);
    if (empty($u->api_token)) {
        App\Models\User::updateRssKey($u->id);
        $u->refresh();
    }
    fwrite(STDERR, "API user '$name' (role '".API_ROLE."': ".API_CAPS['apirequests'].' requests + '.API_CAPS['downloadrequests'].' downloads a day). API key:'.PHP_EOL);
    out($u->api_token);
}

/**
 * Delete releases under the minimum release size (NNTMUX_MIN_RELEASE_MB) or
 * file count, with their .nzb. Collation already refuses such collections, but
 * only from the moment the floor is set: releases formed earlier stay, because
 * the only caller of deletedReleasesByGroup() nntmux ships is a script under
 * `.do_not_run/`.
 */
function cmd_prune(): void
{
    boot();
    $count = fn () => Illuminate\Support\Facades\DB::table('releases')->count();
    $before = $count();
    config(['nntmux.echocli' => false]);
    (new Blacklight\processing\ProcessReleases)->deletedReleasesByGroup();
    $gone = $before - $count();
    if ($gone > 0) {
        out("prune: removed $gone releases under the minimum size");
    }
}

/**
 * The par2 file worth one fetch: the index (no `.volNN+NN`), else the smallest
 * recovery volume. Every par2 file carries the file-description packets that
 * hold the real file names, so either serves; the index is the cheapest.
 */
function par2_message_id(SimpleXMLElement $nzb): ?string
{
    $best = null;
    foreach ($nzb->file as $f) {
        $subject = (string) $f->attributes()->subject;
        if (! preg_match('/\.par2"/i', $subject) || ! isset($f->segments->segment)) {
            continue;
        }
        $bytes = 0;
        foreach ($f->segments->segment as $s) {
            $bytes += (int) $s->attributes()->bytes;
        }
        $rank = [preg_match('/\.vol\d+[+-]\d+\.par2"/i', $subject) ? 1 : 0, $bytes];
        if ($best === null || $rank < $best[0]) {
            $best = [$rank, (string) $f->segments->segment[0]];
        }
    }

    return $best[1] ?? null;
}

/** First segment of the archive's first volume (`.part01.rar`, else a bare `.rar`). */
function first_rar_message_id(SimpleXMLElement $nzb): ?string
{
    $plain = null;
    foreach ($nzb->file as $f) {
        $subject = (string) $f->attributes()->subject;
        if (! isset($f->segments->segment)) {
            continue;
        }
        if (preg_match('/\.part0*1\.rar"/i', $subject)) {
            return (string) $f->segments->segment[0];
        }
        if ($plain === null && preg_match('/\.rar"/i', $subject) && ! preg_match('/\.part\d+\.rar"/i', $subject)) {
            $plain = (string) $f->segments->segment[0];
        }
    }

    return $plain;
}

/** `name.mkv` out of a raw subject such as `[61/63] - "name.mkv.vol127+128.par2" yEnc`. */
function subject_file_name(string $name): ?string
{
    if (! preg_match('/"([^"]{8,})"/', $name, $m)) {
        return null;
    }
    $f = $m[1];
    $f = preg_replace('/(\.vol\d+[+-]\d+)?\.par2$/i', '', $f);
    $f = preg_replace('/(\.part\d+)?\.rar$|\.r\d{2,3}$|\.\d{3}$|\.(sfv|nzb|nfo)$/i', '', $f);

    return strlen($f) >= 8 ? $f : null;
}

/**
 * Rename releases still in the "Other" categories. The scan loop collates and
 * nothing else, so without this most releases keep the raw post subject (or an
 * obfuscated name) as their title and stay uncategorised.
 *
 * nntmux's own runners cannot be used as they ship: groupfixrelnames.php has a
 * SQL syntax error (trailing comma before FROM), fixReleaseNames.php never
 * connects to usenet for its par2 mode (`$argv[1] === 7` compares a string with
 * an int), and NZBContents::checkPAR2 fetches the first article of every file
 * of a release until one parses. This drives the same NameFixer/PostProcess
 * code with at most ONE article fetch per release:
 *   1. the file name quoted in the post subject — no fetch;
 *   2. the file names inside one par2 file — one fetch;
 *   3. the file names inside the archive, read from the first article of its
 *      first volume — one fetch. Needed when the poster obfuscated the names
 *      before making the par2 set, so the par2 only lists the random names.
 * An archive with encrypted headers hides its names behind a password that
 * only the uploader's own indexer has, so nothing can name it: it is marked
 * passworded, which hides it from browsing and the API while
 * showpasswordedrelease=0 (the default).
 * A release is marked proc_par2=1 whatever the outcome, so it is tried once.
 */
function cmd_fixnames(int $limit): void
{
    boot();
    $others = App\Models\Category::OTHERS_GROUP;
    $ids = Illuminate\Support\Facades\DB::table('releases')
        ->where(['nzbstatus' => Blacklight\NZB::NZB_ADDED, 'isrenamed' => 0, 'predb_id' => 0, 'proc_par2' => 0])
        ->whereIn('categories_id', $others)
        ->orderByDesc('id')->limit($limit)->pluck('id');
    if ($ids->isEmpty()) {
        return;
    }

    $fixer = new Blacklight\NameFixer;
    $pp = new Blacklight\processing\PostProcess;
    $contents = new Blacklight\NZBContents;
    $nntp = null;
    $renamed = ['subject' => 0, 'par2' => 0, 'archive' => 0];
    $fetches = 0;
    $locked = 0;
    $examples = [];
    $row = fn ($id) => App\Models\Release::query()->where('id', $id)
        ->select(['id', 'guid', 'groups_id', 'categories_id', 'name', 'searchname', 'fromname', 'postdate', 'id as releases_id'])->first();

    foreach ($ids as $id) {
        $r = $row($id);
        $before = $r->searchname;
        $how = null;

        $file = subject_file_name((string) $r->name);
        if ($file !== null) {
            $fixer->reset();
            $r->textstring = $file;
            if ($fixer->checkName($r, true, 'Filenames, ', 1, false)) {
                $how = 'subject';
            }
        }

        $nzb = $how === null ? $contents->LoadNZB($r->guid) : false;
        if ($nzb !== false && $nntp === null) {
            $nntp = new Blacklight\NNTP;
            if ($nntp->doConnect() !== true) {
                out('fixnames: cannot connect to usenet — par2/archive steps skipped this pass');
                $nntp = false;
            }
        }
        $group = App\Models\UsenetGroup::getNameByID((int) $r->groups_id);

        if ($nzb !== false && $nntp && ($mid = par2_message_id($nzb)) !== null) {
            $fetches++;
            if ($pp->parsePAR2($mid, (int) $id, (int) $r->groups_id, $nntp, 0)) {
                $how = 'par2';
            }
        }

        if ($how === null && $nzb !== false && $nntp && ($mid = first_rar_message_id($nzb)) !== null) {
            $fetches++;
            $data = $nntp->getMessages($group, $mid);
            if (! $nntp->isError($data)) {
                $archive = new dariusiii\rarinfo\ArchiveInfo;
                $archive->setData($data, true);
                if ($archive->isEncrypted) {
                    App\Models\Release::query()->where('id', $id)->update(['passwordstatus' => Blacklight\Releases::PASSWD_RAR]);
                    $locked++;
                } else {
                    foreach ($archive->getArchiveFileList() ?: [] as $inner) {
                        if (empty($inner['name']) || ! empty($inner['is_dir'])) {
                            continue;
                        }
                        $fixer->reset();
                        $r->textstring = $inner['name'];
                        if ($fixer->checkName($r, true, 'Filenames, ', 1, false)) {
                            $how = 'archive';
                            break;
                        }
                    }
                }
            }
        }

        App\Models\Release::query()->where('id', $id)->update(['proc_par2' => 1]);
        if ($how !== null) {
            $renamed[$how]++;
            if (count($examples) < 5) {
                $examples[] = '  '.$before.'  ->  '.App\Models\Release::query()->where('id', $id)->value('searchname');
            }
        }
    }
    if ($nntp) {
        $nntp->doQuit();
    }

    out(sprintf('fixnames: %d checked, %d renamed (subject %d, par2 %d, archive %d), %d encrypted (hidden), %d article fetches',
        count($ids), array_sum($renamed), $renamed['subject'], $renamed['par2'], $renamed['archive'], $locked, $fetches));
    foreach ($examples as $e) {
        out($e);
    }
}

$cmd = $argv[1] ?? 'help';
switch ($cmd) {
    case 'apply':
        cmd_apply();
        break;
    case 'status':
        cmd_status();
        break;
    case 'groups':
        cmd_groups(trim($argv[2] ?? ''));
        break;
    case 'api-user':
        cmd_api_user(trim($argv[2] ?? '') ?: fail('usage: nntmux-setup api-user NAME'));
        break;
    case 'prune':
        cmd_prune();
        break;
    case 'fixnames':
        cmd_fixnames(max(1, (int) ($argv[2] ?? 300)));
        break;
    default:
        out('usage: nntmux-setup status | groups [text] | api-user NAME | apply | prune | fixnames [max]');
        exit($cmd === 'help' ? 0 : 1);
}
