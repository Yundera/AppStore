<Config>
  <BindAddress>*</BindAddress>
  <Port>9696</Port>
  <EnableSsl>False</EnableSsl>
  <LaunchBrowser>False</LaunchBrowser>
  <!-- External: Prowlarr performs no login of its own and trusts the reverse
       proxy in front of it, which is the AppShield OIDC gate (prowlarr-gate).
       Anything the internet can reach has already passed the PCS SSO.

       Forms auth is deliberately NOT used here. Sonarr, Radarr and Lidarr
       consume <Username>/<Password> from this file on first boot and create the
       user row; Prowlarr does NOT - it strips both elements and leaves the
       Users table empty, so Forms would enforce against zero users and lock the
       owner out with no in-browser recovery. Verified on 2.4.0 and on latest. -->
  <AuthenticationMethod>External</AuthenticationMethod>
  <AuthenticationRequired>Enabled</AuthenticationRequired>
  <UrlBase></UrlBase>
  <InstanceName>Prowlarr</InstanceName>
  <UpdateMechanism>Docker</UpdateMechanism>
</Config>
