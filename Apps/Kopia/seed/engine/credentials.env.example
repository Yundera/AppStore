# The storage key the engine uses for the bucket in connect.json.
# Copy this file to credentials.env (same folder) and fill it in.
#
# Backblaze B2: an Application Key restricted to that one bucket.
#   AWS_ACCESS_KEY_ID     = the key's "keyID"
#   AWS_SECRET_ACCESS_KEY = the key's "applicationKey" (shown once, at creation)
#
# Any other S3-compatible service takes its access key and secret here the same way.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
