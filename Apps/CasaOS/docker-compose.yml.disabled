name: casaos

# NOTE — this app ships the `casaos` service ONLY, not `casaos-oidc-bridge`.
# The bridge is PCS infrastructure, not part of CasaOS-the-app: it is the Dex
# connector that backs Yundera SSO, and it needs BRIDGE_SECRET from the PCS
# unified .env — a value the App Store cannot inject. It stays in the yundera
# infrastructure stack, so uninstalling CasaOS here does not take every other
# app's login with it.
#
# (Store apps no longer set CREDENTIAL_VALIDATE_URL against the bridge's
# :8090/validate endpoint — that machine-auth path was dropped ahead of the
# bridge's removal; machine access now goes through AppShield's OAuth broker.)

services:
  casaos:
    image: ghcr.io/yundera/casa-img:0.4.15-47
    container_name: casaos
    hostname: casaos
    restart: unless-stopped
    environment:
      PUID: $PUID # user ID used by casaos to read and write files
      PGID: $PGID # group ID used by casaos to read and write files
      TZ: $TZ
      DATA_ROOT: "/DATA" # where casaos apps data are stored

      # Used by casaos to configure the reverse proxy in the app settings
      # (not used by the casaos system itself).
      REF_DOMAIN: "${APP_DOMAIN}"
      REF_NET: "${APP_NET:-pcs}"
      REF_PORT: "443"
      REF_SCHEME: "https"

      # (deprecated) V1 — not used by casaos directly, forwarded to the apps it
      # creates and injected into their docker compose up.
      default_pwd: "${APP_DEFAULT_PASSWORD}"
      public_ip: "${APP_PUBLIC_IPV4}"
      domain: "${APP_DOMAIN}"

      # (deprecated) V2
      PCS_DEFAULT_PASSWORD: "${APP_DEFAULT_PASSWORD}"
      PCS_DOMAIN: "${APP_DOMAIN}" # without https://
      PCS_DATA_ROOT: "/DATA"
      PCS_PUBLIC_IP: "${APP_PUBLIC_IPV4}"
      PCS_PUBLIC_IPV6: "${APP_PUBLIC_IPV6}"
      PCS_EMAIL: "${APP_EMAIL}"

      # V3
      APP_DEFAULT_PASSWORD: "${APP_DEFAULT_PASSWORD}"
      APP_DOMAIN: "${APP_DOMAIN}" # without https://
      APP_DATA_ROOT: "/DATA"
      APP_PUBLIC_IP: "${APP_PUBLIC_IPV6}" # may be v4 or v6, but is the main IP
      APP_PUBLIC_IP_DASH: "${APP_PUBLIC_IP_DASH}"
      APP_PUBLIC_IPV4: "${APP_PUBLIC_IPV4}"
      APP_PUBLIC_IPV4_DASH: "${APP_PUBLIC_IPV4_DASH}"
      APP_PUBLIC_IPV6: "${APP_PUBLIC_IPV6}"
      APP_PUBLIC_IPV6_DASH: "${APP_PUBLIC_IPV6_DASH}"
      APP_EMAIL: "${APP_EMAIL}"
      APP_NET: ${APP_NET:-pcs}

      # Passwordless email sign-in: casaos enables the magic-link login option
      # only when USER_EMAIL + SMTP_HOST + SMTP_PORT are all set.
      USER_EMAIL: "${APP_EMAIL}"
      SMTP_HOST: "smtp"
      SMTP_PORT: "587"

      # No USER here. On a box that already ran CasaOS the account lives in
      # /DATA/AppData/casaos and is reused; on a fresh one CasaOS shows its
      # first-run account setup. The store has no username to inject.
    expose:
      - 8080
    labels:
      # Standard domains with custom CA (gateway-routed)
      caddy_0: 8080-casaos-${APP_DOMAIN}, casaos-${APP_DOMAIN}
      caddy_0.import: gateway_tls
      caddy_0.reverse_proxy: "{{upstreams 8080}}"
      # nip.io variants for direct access (custom CA)
      caddy_1: 8080-casaos-${APP_PUBLIC_IP_DASH}.nip.io, casaos-${APP_PUBLIC_IP_DASH}.nip.io
      caddy_1.import: gateway_tls
      caddy_1.reverse_proxy: "{{upstreams 8080}}"
      # sslip.io variants for direct access (Let's Encrypt)
      caddy_2: 8080-casaos-${APP_PUBLIC_IP_DASH}.sslip.io, casaos-${APP_PUBLIC_IP_DASH}.sslip.io
      caddy_2.reverse_proxy: "{{upstreams 8080}}"
    networks:
      - pcs
    cpu_shares: 90
    deploy:
      resources:
        limits:
          memory: 1G
    volumes:
      - type: bind
        source: ${DATA_ROOT:-/DATA}
        target: /DATA
        # Bind propagation for FUSE mounts
        bind:
          propagation: rshared
      - type: bind
        source: /var/run/docker.sock
        target: /var/run/docker.sock
      - type: bind
        source: /dev
        target: /dev

networks:
  pcs:
    name: ${APP_NET:-pcs}
    external: true

x-casaos:
  architectures:
    - amd64
    - arm64
  main: casaos
  author: Yundera Team
  category: Utilities
  tags: ["dashboard", "apps", "system"]
  developer: IceWhale
  icon: https://cdn.jsdelivr.net/gh/Yundera/AppStore@main/Apps/CasaOS/icon.png
  index: /
  port_map: "443"
  scheme: https
  webui_port: 8080
  title:
    en_us: CasaOS
  tagline:
    en_us: The original Personal Cloud Server dashboard and app installer.
    fr_fr: Le tableau de bord et installateur d'applications d'origine du serveur cloud personnel.
  description:
    en_us: |
      CasaOS is the dashboard that Yundera Personal Cloud Servers have shipped with since the beginning — a home screen for your server, showing every app you have installed and letting you add more in one click.

      It is being succeeded by CasaDash, which is faster, lighter, and manages the same apps. CasaOS remains available for anyone who prefers it, or who needs a feature CasaDash has not picked up yet.

      Both dashboards read the same apps and the same data directory, so you can run them side by side and switch whenever you like.
    fr_fr: |
      CasaOS est le tableau de bord livré avec les serveurs cloud personnels Yundera depuis l'origine — un écran d'accueil pour votre serveur, affichant toutes vos applications installées et permettant d'en ajouter d'autres en un clic.

      Il est en cours de remplacement par CasaDash, plus rapide et plus léger, qui gère les mêmes applications. CasaOS reste disponible pour ceux qui le préfèrent ou qui ont besoin d'une fonctionnalité que CasaDash ne propose pas encore.

      Les deux tableaux de bord lisent les mêmes applications et le même répertoire de données : vous pouvez les utiliser côte à côte et passer de l'un à l'autre quand vous le souhaitez.
  tips:
    before_install:
      en_us: |
        CasaOS manages Docker on your server, so it can see and control every app
        you have installed.

        Its data directory (`/DATA/AppData/casaos`) also holds the definitions of
        every app on this server. Uninstalling CasaOS leaves that directory in
        place — nothing else is removed.

x-compose-app:
  webui-host: casaos-${domain}
